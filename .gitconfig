[user]
    name = tarnas14
    email = tarnas14@gmail.com
    ; https://sites.lafayette.edu/newquisk/archives/504
    signingkey = 06C2DFB88BC0F185
[core]
    excludesfile = ~/.gitignore_global
    autocrlf = input
[pull]
    rebase = false
[push]
    default = simple
[commit]
    gpgsign = true
[gpg]
    program = gpg
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[diff]
    tool = kitty
    guitool = kitty.gui
[difftool]
    prompt = false
    trustExitCode = true
[difftool "kitty"]
    cmd = kitten diff $LOCAL $REMOTE
[difftool "kitty gui"]
    cmd = kitten diff $LOCAL $REMOTE
