[core]
    excludesfile = ~/.gitignore_global
    autocrlf = input
[pull]
    rebase = false
[push]
    default = simple
[commit]
    gpgsign = true
[gpg]
    program = gpg
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[diff]
    tool = kitty
    guitool = kitty.gui
[difftool]
    prompt = false
    trustExitCode = true
[difftool "kitty"]
    cmd = kitten diff $LOCAL $REMOTE
[difftool "kitty gui"]
    cmd = kitten diff $LOCAL $REMOTE
[include]
    ; identity and key per machine: arch/gitconfig.local or ubuntu/gitconfig.local, linked by that host's setup.sh
    path = ~/.gitconfig.local
